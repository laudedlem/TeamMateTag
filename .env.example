# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Supabase Postgres connection URI (Transaction Pooler mode, port 6543).
# Settings -> Database -> Connection string -> "Transaction" pooler.
# Looks like:
#   postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase project URL (for the JS client, used by auth later).
# Settings -> API -> Project URL.
SUPABASE_URL=

# Supabase anon key (safe to expose to the browser; needed for client-side auth).
# Settings -> API -> Project API keys -> anon / public.
SUPABASE_ANON_KEY=

# Supabase service role key (NEVER expose to the browser; server-side only).
# Settings -> API -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used for password reset links.
# Set this to your real public site, not a preview URL.
# Examples:
#   http://127.0.0.1:5000
#   https://teammatetag.vercel.app
#   https://teammatetag.com
PUBLIC_APP_URL=
